# Environment Variables for Training Compiler Portal
# Copy this to .env.local and fill in your values

# =============================================
# DATABASE (PostgreSQL)
# =============================================
# Options: Railway, Neon, Supabase, or local
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL="postgresql://user:password@localhost:5432/training_compiler"

# =============================================
# NEXTAUTH.JS v5
# =============================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# =============================================
# JUDGE0 CODE EXECUTION API
# =============================================
# Get free key at: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_KEY="your-rapidapi-key-here"
JUDGE0_BASE_URL="https://judge0-ce.p.rapidapi.com"

# =============================================
# CLOUDINARY (File/Image/Video Storage)
# =============================================
# Get free account at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# =============================================
# EMAIL (Optional - for notifications)
# =============================================
# Option 1: SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Option 2: Resend (recommended)
# RESEND_API_KEY="re_your-key-here"

# =============================================
# APP CONFIG
# =============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Training Compiler"
