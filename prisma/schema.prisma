// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}


datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STUDENT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TestType {
  CODING
  MCQ
  MIXED
}

enum TestStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
  PARTIAL
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_IN_BLANK
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String?
  role           Role     @default(STUDENT)
  photo          String?
  phone          String?
  college        String?
  department     String?
  year           String?
  skills         String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Auth
  accounts       Account[]
  sessions       Session[]

  // Relations
  enrollments        Enrollment[]
  testAssignments    TestAssignment[]
  submissions        Submission[]
  mcqSubmissions     MCQSubmission[]
  certificates       Certificate[]
  createdCourses     Course[]         @relation("CourseCreator")
  createdTests       Test[]           @relation("TestCreator")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String       @db.Text
  thumbnail   String?
  duration    String?
  difficulty  Difficulty   @default(EASY)
  status      CourseStatus @default(DRAFT)
  createdBy   String
  creator     User         @relation("CourseCreator", fields: [createdBy], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lessons     Lesson[]
  tests       Test[]
  enrollments Enrollment[]
  batches     Batch[]
  certificates Certificate[]

  @@map("courses")
}

model Lesson {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  content   String?  @db.Text
  videoUrl  String?
  pdfUrl    String?
  order     Int      @default(0)
  duration  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

model Batch {
  id        String   @id @default(cuid())
  name      String
  courseId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course          Course?          @relation(fields: [courseId], references: [id])
  testAssignments TestAssignment[]

  @@map("batches")
}

model Test {
  id           String     @id @default(cuid())
  courseId     String?
  title        String
  description  String?    @db.Text
  type         TestType   @default(CODING)
  duration     Int        // in minutes
  startDate    DateTime?
  endDate      DateTime?
  passingMarks Int        @default(40)
  totalMarks   Int        @default(100)
  status       TestStatus @default(DRAFT)
  createdBy    String
  creator      User       @relation("TestCreator", fields: [createdBy], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  course          Course?          @relation(fields: [courseId], references: [id])
  questions       Question[]
  codingProblems  CodingProblem[]
  testAssignments TestAssignment[]
  mcqSubmissions  MCQSubmission[]

  @@map("tests")
}

model Question {
  id            String       @id @default(cuid())
  testId        String
  type          QuestionType @default(SINGLE_CHOICE)
  title         String       @db.Text
  options       Json?        // Array of options for MCQ
  correctAnswer Json?        // String or array for multiple choice
  explanation   String?      @db.Text
  marks         Int          @default(1)
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  test          Test         @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model CodingProblem {
  id               String     @id @default(cuid())
  testId           String?
  title            String
  description      String     @db.Text
  difficulty       Difficulty @default(EASY)
  constraints      String?    @db.Text
  inputFormat      String?    @db.Text
  outputFormat     String?    @db.Text
  sampleInput      String?    @db.Text
  sampleOutput     String?    @db.Text
  marks            Int        @default(10)
  timeLimit        Int        @default(2)    // seconds
  memoryLimit      Int        @default(256)  // MB
  enabledLanguages String[]   @default(["python", "javascript", "java", "cpp", "c"])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  test             Test?        @relation(fields: [testId], references: [id])
  testCases        TestCase[]
  submissions      Submission[]

  @@map("coding_problems")
}

model TestCase {
  id        String   @id @default(cuid())
  problemId String
  input     String   @db.Text
  output    String   @db.Text
  isHidden  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  problem   CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

model Submission {
  id            String           @id @default(cuid())
  studentId     String
  problemId     String
  language      String
  code          String           @db.Text
  score         Int              @default(0)
  status        SubmissionStatus @default(PENDING)
  passedCases   Int              @default(0)
  totalCases    Int              @default(0)
  executionTime Float?           // ms
  memoryUsed    Float?           // KB
  errorMessage  String?          @db.Text
  createdAt     DateTime         @default(now())

  student       User             @relation(fields: [studentId], references: [id])
  problem       CodingProblem    @relation(fields: [problemId], references: [id])

  @@map("submissions")
}

model MCQSubmission {
  id          String   @id @default(cuid())
  studentId   String
  testId      String
  answers     Json     // { questionId: answer }
  score       Int      @default(0)
  totalMarks  Int      @default(0)
  timeTaken   Int?     // seconds
  submittedAt DateTime @default(now())

  student     User     @relation(fields: [studentId], references: [id])
  test        Test     @relation(fields: [testId], references: [id])

  @@map("mcq_submissions")
}

model Enrollment {
  id          String    @id @default(cuid())
  studentId   String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  progress    Int       @default(0) // percentage

  student     User      @relation(fields: [studentId], references: [id])
  course      Course    @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model TestAssignment {
  id          String   @id @default(cuid())
  testId      String
  studentId   String?
  batchId     String?
  assignedAt  DateTime @default(now())
  deadline    DateTime?

  test        Test     @relation(fields: [testId], references: [id])
  student     User?    @relation(fields: [studentId], references: [id])
  batch       Batch?   @relation(fields: [batchId], references: [id])

  @@map("test_assignments")
}

model Certificate {
  id            String   @id @default(cuid())
  studentId     String
  courseId      String
  certificateId String   @unique @default(cuid())
  issuedAt      DateTime @default(now())

  student       User     @relation(fields: [studentId], references: [id])
  course        Course   @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
  @@map("certificates")
}
