generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model accounts {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  users             users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model batches {
  id               String             @id
  name             String
  courseId         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  courses          courses?           @relation(fields: [courseId], references: [id])
  test_assignments test_assignments[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model certificates {
  id            String   @id
  studentId     String
  courseId      String
  certificateId String   @unique
  issuedAt      DateTime @default(now())
  courses       courses  @relation(fields: [courseId], references: [id])
  users         users    @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model coding_problems {
  id               String        @id
  testId           String?
  title            String
  description      String
  difficulty       String        @default("EASY")
  constraints      String?
  inputFormat      String?
  outputFormat     String?
  sampleInput      String?
  sampleOutput     String?
  marks            Int           @default(10)
  timeLimit        Int           @default(2)
  memoryLimit      Int           @default(256)
  enabledLanguages String        @default("[\"python\", \"javascript\", \"java\", \"cpp\", \"c\"]")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  tests            tests?        @relation(fields: [testId], references: [id])
  submissions      submissions[]
  test_cases       test_cases[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model courses {
  id           String         @id
  title        String
  description  String
  thumbnail    String?
  duration     String?
  difficulty   String         @default("EASY")
  status       String         @default("DRAFT")
  createdBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  batches      batches[]
  certificates certificates[]
  users        users          @relation(fields: [createdBy], references: [id])
  enrollments  enrollments[]
  lessons      lessons[]
  tests        tests[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model enrollments {
  id          String    @id
  studentId   String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  progress    Int       @default(0)
  courses     courses   @relation(fields: [courseId], references: [id])
  users       users     @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model lessons {
  id        String   @id
  courseId  String
  title     String
  content   String?
  videoUrl  String?
  pdfUrl    String?
  order     Int      @default(0)
  duration  String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  courses   courses  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model mcq_submissions {
  id          String   @id
  studentId   String
  testId      String
  answers     String
  score       Int      @default(0)
  totalMarks  Int      @default(0)
  timeTaken   Int?
  submittedAt DateTime @default(now())
  users       users    @relation(fields: [studentId], references: [id])
  tests       tests    @relation(fields: [testId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model mcq_topics {
  id          String      @id
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  questions   questions[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model questions {
  id            String      @id
  testId        String?
  type          String      @default("SINGLE_CHOICE")
  title         String
  options       String?
  correctAnswer String?
  explanation   String?
  marks         Int         @default(1)
  order         Int         @default(0)
  mcqTopicId    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  mcq_topics    mcq_topics? @relation(fields: [mcqTopicId], references: [id])
  tests         tests?      @relation(fields: [testId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sessions {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  users        users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model submissions {
  id              String          @id
  studentId       String
  problemId       String
  language        String
  code            String
  score           Int             @default(0)
  status          String          @default("PENDING")
  passedCases     Int             @default(0)
  totalCases      Int             @default(0)
  executionTime   Float?
  memoryUsed      Float?
  errorMessage    String?
  createdAt       DateTime        @default(now())
  coding_problems coding_problems @relation(fields: [problemId], references: [id])
  users           users           @relation(fields: [studentId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model test_assignments {
  id         String    @id
  testId     String
  studentId  String?
  batchId    String?
  assignedAt DateTime  @default(now())
  deadline   DateTime?
  batches    batches?  @relation(fields: [batchId], references: [id])
  users      users?    @relation(fields: [studentId], references: [id])
  tests      tests     @relation(fields: [testId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model test_cases {
  id              String          @id
  problemId       String
  input           String
  output          String
  isHidden        Boolean         @default(false)
  order           Int             @default(0)
  createdAt       DateTime        @default(now())
  coding_problems coding_problems @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tests {
  id               String             @id
  courseId         String?
  title            String
  description      String?
  type             String             @default("CODING")
  duration         Int
  startDate        DateTime?
  endDate          DateTime?
  passingMarks     Int                @default(40)
  totalMarks       Int                @default(100)
  status           String             @default("DRAFT")
  createdBy        String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  coding_problems  coding_problems[]
  mcq_submissions  mcq_submissions[]
  questions        questions[]
  test_assignments test_assignments[]
  courses          courses?           @relation(fields: [courseId], references: [id])
  users            users              @relation(fields: [createdBy], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id               String             @id
  name             String
  email            String             @unique
  password         String?
  role             String             @default("STUDENT")
  photo            String?
  phone            String?
  college          String?
  department       String?
  year             String?
  skills           String             @default("[]")
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  accounts         accounts[]
  certificates     certificates[]
  courses          courses[]
  enrollments      enrollments[]
  mcq_submissions  mcq_submissions[]
  sessions         sessions[]
  submissions      submissions[]
  test_assignments test_assignments[]
  tests            tests[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model verification_tokens {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
